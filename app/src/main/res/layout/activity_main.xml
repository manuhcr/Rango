<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/ToolbarVerde"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:title="@string/app_name" />

        <TextView
            android:id="@+id/txtSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_escuro"
            android:padding="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/verde_android"
            android:textSize="13sp"
            tools:text="8 lugares em todas as categorias" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF">

            <!--
                A RecyclerView em si é só isto. Altura match_parent aqui é
                correto: quem não pode ser match_parent é a raiz do LAYOUT DO
                ITEM, que é outro arquivo.
            -->

            <!-- Estado vazio: faz parte da interface, não é acidente. -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLugares"
                android:layout_width="match_parent"
                android:layout_height="691dp"
                android:layout_marginTop="40dp"
                android:background="#FFFFFF"
                android:clipToPadding="false"
                android:paddingBottom="0dp"
                tools:listitem="@layout/item_lugar" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNovo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/novo_titulo"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/verde_android"
        app:tint="@color/verde_escuro" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
